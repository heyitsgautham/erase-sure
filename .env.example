# Copy to .env in the folder you run securewipe from; the CLI loads it at startup.
# The portal reads SECUREWIPE_PUBKEY_PATH from its process environment.

# Ed25519 PKCS#8 private key the CLI signs certificates with (when --sign-key-path is not given).
SECUREWIPE_SIGN_KEY_PATH=keys/dev_private.pem

# Ed25519 public key the portal trusts when verifying signatures.
SECUREWIPE_PUBKEY_PATH=keys/dev_public.pem

# Destructive wipes need this set to 1 in addition to --danger-allow-wipe. Keep it 0.
SECUREWIPE_DANGER=0

# Non-interactive wipe confirmation: "WIPE <device serial>" or "CONFIRM WIPE". Leave unset to be prompted.
# SECUREWIPE_CONFIRM_TOKEN=

# Host port docker compose publishes the portal on.
PORTAL_PORT=8000
